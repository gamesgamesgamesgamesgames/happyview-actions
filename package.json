{
  "name": "happyview-actions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "rm -rf deploy/dist lint/dist && esbuild src/deploy/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=deploy/dist/index.cjs && esbuild src/lint/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=lint/dist/index.cjs"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "fast-glob": "^3.3.2",
    "glob-parent": "^6.0.2",
    "luaparse": "^0.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@types/glob-parent": "^5.1.3",
    "@types/luaparse": "^0.2.12",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "semantic-release": "^25.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
